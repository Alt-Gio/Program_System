# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# FACE RECOGNITION ATTENDANCE
# Front-end wiring for the /attendance pages. The server-side
# FACE_SHARED_TOKEN lives on the Convex deployment — set it via:
#   npx convex env set FACE_SHARED_TOKEN "<value from cv-station/server/.env>"
# ─────────────────────────────────────────────────────────────

# Full ws(s):// URL to the face recognition server's WebSocket
# endpoint. If left unset, the /attendance/camera page falls back
# to ws(s)://<current-host>:8001/ws/camera (works when Next.js and
# the face server run on the same box).
NEXT_PUBLIC_FACE_SERVER_WS=

# Base HTTP URL for the face server's REST endpoints (used by the
# /attendance/register page). e.g. http://192.168.1.10:8001
NEXT_PUBLIC_FACE_SERVER_HTTP=http://localhost:8001

# Optional browser → face-server auth. Leave empty to disable.
# If set, must match FACE_API_TOKEN in cv-station/server/.env.
NEXT_PUBLIC_FACE_API_TOKEN=
