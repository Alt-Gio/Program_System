# ─────────────────────────────────────────────────────────────
# DICT R5 — Face Recognition Server
# Copy to `.env` and fill the values you need.
# ─────────────────────────────────────────────────────────────

# Base URL for the Convex HTTP actions router. For self-hosted
# Convex this is usually a separate port (3211 by default).
FACE_CONVEX_HTTP_URL=http://localhost:3211
FACE_CONVEX_ENDPOINT=/face/attendance

# Shared token used to authenticate the Python server → Convex
# httpAction. MUST match the FACE_SHARED_TOKEN env var on the
# Convex deployment (`npx convex env set FACE_SHARED_TOKEN ...`).
FACE_SHARED_TOKEN=change-me-long-random-string

# Optional: require this same token on REST/WS from the browser
# (leave empty to disable). If set, the Next.js app must pass
# NEXT_PUBLIC_FACE_API_TOKEN with the same value.
FACE_API_TOKEN=

# Tuning
MATCH_THRESHOLD=0.45
COOLDOWN_SECONDS=30
GPU_CONCURRENCY=1
MAX_FRAME_BYTES=4194304
TIMEZONE=Asia/Manila

# Listen config
HOST=0.0.0.0
PORT=8001

# CORS — comma-separated list of allowed origins. Use * for local dev.
CORS_ORIGINS=*

# Persistent storage paths (inside the container)
FACE_DB_PATH=/data/faces.db

# Logging
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info
