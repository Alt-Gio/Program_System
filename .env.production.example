# ─────────────────────────────────────────────────────────────
# DICT R5 PMS — production env (single-box deployment)
#
# Copy to .env.production (gitignored) and fill in.
# Used by docker-compose.prod.yml AND baked into the Next.js
# image at build time (NEXT_PUBLIC_* only).
#
# Replace 192.168.1.50 with the LAN IP of the host machine.
# Find it on Windows with:  ipconfig | findstr IPv4
# ─────────────────────────────────────────────────────────────

# ── Convex self-hosted ─────────────────────────────────────────
# Generate ONCE with:  openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace_with_64_char_hex_secret
# What URL the browser uses to talk to the Convex backend.
# Must be reachable from EVERY device that opens the app
# (host PC + kiosk PC + admin laptops).
CONVEX_CLOUD_ORIGIN=http://192.168.1.50:3210
CONVEX_SITE_ORIGIN=http://192.168.1.50:3211

# ── Next.js public env (baked at build time) ──────────────────
NEXT_PUBLIC_CONVEX_URL=http://192.168.1.50:3210

# Browser → face server. Same host, port 8001.
NEXT_PUBLIC_FACE_SERVER_HTTP=http://192.168.1.50:8001
NEXT_PUBLIC_FACE_SERVER_WS=ws://192.168.1.50:8001/ws/camera
NEXT_PUBLIC_FACE_API_TOKEN=

# Mapbox (only needed if you use the map page).
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── NextAuth (sessions, signing) ──────────────────────────────
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret
NEXTAUTH_URL=http://192.168.1.50:3000

# ── Google OAuth (login) ──────────────────────────────────────
# Add http://192.168.1.50:3000/api/auth/callback/google
# AND  http://192.168.1.50:3000/api/auth/google/callback
# to "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DICT_GOOGLE_CLIENT_ID=
DICT_GOOGLE_CLIENT_SECRET=
DICT_GOOGLE_REDIRECT_URI=http://192.168.1.50:3000/api/auth/google/callback
DICT_OAUTH_SECRET=replace_with_random_secret

# ── Google Sheets sync (optional) ─────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Face server tuning ────────────────────────────────────────
# This token authenticates the face server's POST /face/attendance
# webhook. Set the SAME value on the Convex deployment with:
#   npx convex env set FACE_SHARED_TOKEN "<value>" --url http://192.168.1.50:3210
FACE_SHARED_TOKEN=replace_with_long_random_string
FACE_API_TOKEN=
MATCH_THRESHOLD=0.45
COOLDOWN_SECONDS=30
GPU_CONCURRENCY=1
MAX_FRAME_BYTES=4194304
TIMEZONE=Asia/Manila
CORS_ORIGINS=*
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info
