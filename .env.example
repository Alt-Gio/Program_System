# Convex
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Google OAuth (for Sheets import/export)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Google Sheets (service account for server-side export)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Target Google Sheet for exports (DICT_Results)
# Get this ID from the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_TARGET_ID=YOUR_DICT_RESULTS_SPREADSHEET_ID_HERE

NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3210

# Dual Database Sync — Google Sheets write (used by /api/sync-trigger and /api/sheets-write)
# Option A: Full JSON key (preferred)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}
# Option B: Separate email + key (fallback — reuses existing vars above)
# GOOGLE_SERVICE_ACCOUNT_EMAIL and GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY

# Sheet IDs for sync targets
DICT_ATTENDANCE_LOG_SHEET_ID=1XgHuvgjYbQjNJOqJLjatj2MvspHnnLdtDW2CjqHPy4Y
DICT_DTC_LOGBOOK_SHEET_ID=1_UOkMr7qba-NfoS9Wl8Pu92elFk-DLFbnPWmKaUxlp4
DICT_SYNC_STATUS_SHEET_ID=1feIZuIyRsw-Qf8KbIsms7oO_-NgL32x_AejmolrNc3c

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=local:local-your-deployment
